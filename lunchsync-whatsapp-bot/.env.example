# =============================================================================
# LunchSync WhatsApp Bot - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values

# --- Server ---
PORT=3001

# --- Backend ---
BACKEND_URL=http://localhost:3000

# --- Bot Auth (must match BACKEND BOT_INTERNAL_SECRET) ---
BOT_INTERNAL_SECRET=CHANGE_ME_use_same_value_in_backend

# --- Chrome Path for whatsapp-web.js ---
# CHROME_BIN=/usr/bin/google-chrome
# CHROME_BIN=C:\Program Files\Google\Chrome\Application\chrome.exe

# --- WhatsApp Session Storage ---
# STORAGE_PATH=./storage/whatsapp
