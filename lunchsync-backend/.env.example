# =============================================================================
# LunchSync Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=lunchsync
DB_PASSWORD=CHANGE_ME
DB_DATABASE=lunchsync

# --- JWT ---
JWT_SECRET=CHANGE_ME_use_strong_random_string
JWT_EXPIRES_IN=24h

# --- WhatsApp Bot Service ---
WHATSAPP_BOT_URL=http://localhost:3001

# --- Bot Internal Auth ---
BOT_INTERNAL_SECRET=CHANGE_ME_use_same_value_in_bot

# --- Server ---
PORT=3000

# --- Frontend URL (for magic links) ---
# Leave empty to auto-detect from network interface
# FRONTEND_URL=http://localhost:5173
# FRONTEND_PORT=5173
